module sequence_det_1011(
  input clk,
  input rst,
  input din,
  output reg det
);
  
  parameter S0 = 3'b000; //idle
  parameter S1 = 3'b001; //1
  parameter S2 = 3'b010; //10
  parameter S3 = 3'b011;//101
  parameter S4 = 3'b100; //1011
  
  reg [2:0] current_state;
  reg [2:0] next_state;
  
  always @ (posedge clk or posedge rst)begin
    if(rst)
      current_state=S0;
    else
      current_state <= next_state;
  end
  
  always @ (*) begin
    next_state = S0;
    
    
    case(current_state)
      S0 : begin
        if (din) 
          next_state = S1;
        else 
          next_state = S0;
      end
      
      S1 : begin
        if (din) 
          next_state = S1;
        else 
          next_state = S2;
      end
      
      S2 : begin
        if (din) 
          next_state = S3;
        else 
          next_state = S0;
      end
      
      S3 : begin
        if (din) 
          next_state = S4;
        else 
          next_state = S2;
      end
      
      S4 : begin
        if (din) 
          next_state = S1; //overlapind case
        else 
          next_state = S2;
      end
      
      default : next_state = S0;
    endcase
  end
  
  always @(*) begin
    det = 0;
    if (current_state === S4)
      det = 1;
  end
  
endmodule
  
  
  
  
  
